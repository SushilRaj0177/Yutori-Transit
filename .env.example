# ODPT (https://developer.odpt.org/). Either key works; the standard one is tried first.
ODPT_CONSUMER_KEY=
ODPT_CHALLENGE_KEY=

# Optional: key of a per-car load array on odpt:Train records, if `npm run odpt:probe`
# finds one. Leave empty and the app uses its labelled crowding estimate.
ODPT_CAR_LOAD_FIELD=

# Optional: Groq key for the plain-language narration. Without it the app uses
# the deterministic template, which carries the same facts.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Rider reports (platform positions). Use a Postgres URL in production, e.g. a
# free Neon database. Without it: local dev uses an embedded database in .data/,
# and a Vercel deployment turns contributions off rather than losing them.
DATABASE_URL=
# Secret used to hash device ids and IP addresses before storing them. Set a long random value.
REPORT_SALT=
