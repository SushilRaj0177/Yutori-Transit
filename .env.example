# ODPT (https://developer.odpt.org/). Either key works; the standard one is tried first.
ODPT_CONSUMER_KEY=
ODPT_CHALLENGE_KEY=

# Optional: key of a per-car load array on odpt:Train records, if `npm run odpt:probe`
# finds one. Leave empty and the app uses its labelled crowding estimate.
ODPT_CAR_LOAD_FIELD=

# Optional: Groq key for the plain-language narration. Without it the app uses
# the deterministic template, which carries the same facts.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
